# Supabase (get these from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin portal login password (single admin)
ADMIN_PASSWORD=change-me-in-production

# Session signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Cron secret — protects GET /api/cron/finalize
CRON_SECRET=change-me-to-a-long-random-string

NODE_ENV=development
